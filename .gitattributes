# 统一换行策略：文本文件在仓库中一律 LF，由各编辑器自行处理工作区换行
* text=auto eol=lf

# 明确声明文本文件
*.py text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.lock text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.python-version text eol=lf

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做任何转换
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.db binary
*.exe binary
*.dll binary
